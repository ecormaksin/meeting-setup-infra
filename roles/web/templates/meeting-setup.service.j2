[Unit]
Description=Web app to organize schedules for meetings
After=syslog.target
ConditionPathExists={{ web_app_base_directory }}
 
[Service]
User={{ web_app_user }}
ExecStart={{ web_app_base_directory }}/start_app.sh
Restart=always
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=meeting-setup
SuccessExitStatus=143
 
[Install] 
WantedBy=multi-user.target
