all:
  hosts:
  children:
    webservers:
      hosts:
        web-vm-01-01:
    dbservers:
      hosts:
        db-vm-01-02:
  vars:
    ansible_user: <Ansible Playbookを実行する時のユーザー>
    ansible_become_pass: <上記ユーザーで管理者権限の必要なコマンドを実行する時のパスワード>
    ansible_ssh_private_key_file: <AnsibleホストへSSH接続する時のprivate鍵パス>
